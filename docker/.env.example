# QQ 机器人凭证与白名单（复制为 .env 并填写）
# AppID/AppSecret：q.qq.com 开发者后台 → 机器人 → 开发设置（见 docs/QQ机器人申请指南.md）
QQ_APP_ID=your_qq_bot_app_id
QQ_APP_SECRET=your_qq_bot_app_secret
# 你的 openid：机器人上线后给它发 /whoami 获取，实现白名单只放行你自己
QQ_ALLOW_FROM=your_qq_openid
# ACP 子进程内嵌 server 的访问密码（TUI attach 用，本地环回）
OP_SERVER_PASSWORD=your_local_password
