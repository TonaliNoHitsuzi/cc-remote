+// contextUsageRichText renders agent-reported context usage as
+// "[ctx: 8.6k/200k · 4% · cache 99%]". Empty string when no real data.
+func contextUsageRichText(usage *ContextUsage) string {
+	if usage == nil || usage.ContextWindow <= 0 || usage.UsedTokens <= 0 {
+		return ""
+	}
+	pct := int(float64(usage.UsedTokens) / float64(usage.ContextWindow) * 100)
+	if pct > 100 {
+		pct = 100
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "[ctx: %s/%s · %d%%", humanTokenCount(usage.UsedTokens), humanTokenCount(usage.ContextWindow), pct)
+	if usage.CachedInputTokens > 0 {
+		cpct := int(float64(usage.CachedInputTokens) / float64(usage.UsedTokens) * 100)
+		if cpct > 100 {
+			cpct = 100
+		}
+		fmt.Fprintf(&b, " · cache %d%%", cpct)
+	}
+	b.WriteString("]")
+	return b.String()
+}
+
+func humanTokenCount(n int) string {
+	if n >= 1000 {
+		return fmt.Sprintf("%.1fk", float64(n)/1000)
+	}
+	return fmt.Sprintf("%d", n)
+}
